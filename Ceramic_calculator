        "def measurement_validation(dry_length, dry_mass, final_length, final_mass, suspended_mass, saturated_mass):\n",
        "  \"\"\"\n",
        "  Compare the final values with the initial. Returns True if inputs are valid, False otherwise.\n",
        "  The suspended mass must be less than the final_mass and saturated_mass.\n",
        "  final_mass must be less than dry_mass and saturated_mass.\n",
        "  \"\"\"\n",
        "  is_valid = True\n",
        "  if final_mass > saturated_mass:\n",
        "    print('Validation Error: Saturated mass must be greater than final mass.')\n",
        "    is_valid = False\n",
        "\n",
        "  if suspended_mass > final_mass:\n",
        "    print('Validation Error: Suspended mass must be less than final mass.')\n",
        "    is_valid = False\n",
        "\n",
        "  if final_mass > dry_mass:\n",
        "    print('Validation Error: Final mass must be less than dry mass.')\n",
        "    is_valid = False\n",
        "\n",
        "  if final_length > dry_length:\n",
        "    print('Validation Error: Final length must be less than dry length.')\n",
        "    is_valid = False\n",
        "\n",
        "  return is_valid"
      ],
