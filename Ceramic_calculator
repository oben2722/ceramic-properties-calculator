        "def standardized_formulations():\n",
        "  \"\"\"\n",
        "  This function takes in the different proportion of raw materials\n",
        "  and verify if their sum equals a 100. if not it will standardize all raw materials.\n",
        "  \"\"\"\n",
        "  print(\"--- Standardizing Formulation --- \")\n",
        "  kaolin = get_positive_float('Enter the proportion of kaolin: ')\n",
        "  rice_husk = get_positive_float('Enter the proportion of rice husk: ')\n",
        "  calcite = get_positive_float('Enter the proportion of calcite: ')\n",
        "  feldspar = get_positive_float('Enter the proportion of feldspar: ')\n",
        "  quartz = get_positive_float('Enter the proportion of quartz: ')\n",
        "  total_sum = kaolin + rice_husk + calcite + feldspar + quartz\n",
        "\n",
        "  if total_sum != 100.0:\n",
        "    print(\"The sum of the proportions is not equal to 100. Standardizing proportions...\")\n",
        "    kaolin = (kaolin / total_sum) * 100.0\n",
        "    rice_husk = (rice_husk / total_sum) * 100.0\n",
        "    calcite = (calcite / total_sum) * 100.0\n",
        "    feldspar = (feldspar / total_sum) * 100.0\n",
        "    quartz = (quartz / total_sum) * 100.0\n",
        "\n",
        "    print(f\"Standardized proportions: Kaolin = {kaolin:.2f}%, Rice Husk = {rice_husk:.2f}%, Calcite = {calcite:.2f}%, Feldspar = {feldspar:.2f}%, Quartz = {quartz:.2f}%\")\n",
        "  return kaolin, rice_husk, calcite, feldspar, quartz"
      ],
