        "def get_positive_float(prompt):\n",
        "  while True:\n",
        "    try:\n",
        "      value = float(input(prompt))\n",
        "      if value <= 0:\n",
        "        print(\"Please enter a positive number.\")\n",
        "      else:\n",
        "        return value\n",
        "    except ValueError:\n",
        "      print(\"Please enter a valid number.\")"
