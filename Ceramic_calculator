        "def initial_dimensions():\n",
        "  \"\"\"\n",
        "This functions takes the initial dimensions of the ceramic membrane before sintering.\n",
        "the dimensions are in mm and they include dry_length, dry_thickness, dry_width\n",
        "The surface area and volume of dry membrane before firing will be calculated.\n",
        "This values will be use in calculating the linear shrinkage.\n",
        "  \"\"\"\n",
        "\n",
        "  dry_length = get_positive_float('Enter the length of the dry membrane in mm')\n",
        "  dry_thickness = get_positive_float('Enter the thickness of the dry membrane in mm')\n",
        "  dry_width = get_positive_float('Enter the width of the dry membrane in mm')\n",
        "  dry_mass = get_positive_float('Enter the mass of the dry membrane in g')\n",
        "  dry_surface_area = dry_length * dry_width\n",
        "  dry_volume = dry_length * dry_thickness * dry_width\n",
        "  dry_bulk_density = dry_mass / dry_volume\n",
        "\n",
        "  theoritical_density = get_positive_float('Enter the theoritical density of the membrane in g/cm3')\n",
        "  print(f\"The surface area of the dry membrane is {dry_surface_area} mm^2  the volume is {dry_volume} mm^3,theoritical_density{theoritical_density}, dry_bulk_density is {dry_bulk_density} g/cm3\")\n",
        "\n",
        "  return dry_length, dry_thickness, dry_width, dry_surface_area, dry_volume, dry_mass, dry_bulk_density, theoritical_density"
      ],
