        "def final_measurement(dry_length, dry_mass, theoritical_density):\n",
        "  \"\"\"\n",
        "  This function takes in the final measurements after firing and initial characterization\n",
        "  so as to determine the physical properties of membrane.\n",
        "  \"\"\"\n",
        "  print(\"\\n--- Final Physical Characterization (ASTM C 373) ---\")\n",
        "  while True:\n",
        "    final_length = get_positive_float('Enter the length of the final membrane in mm : ')\n",
        "    final_thickness = get_positive_float('Enter the thickness of the final membrane in mm : ')\n",
        "    final_width = get_positive_float('Enter the width of the final membrane in mm : ')\n",
        "    final_mass = get_positive_float('Enter the mass of the final membrane in g : ')\n",
        "    suspended_mass = get_positive_float('Enter the suspended mass of the final membrane in g : ')\n",
        "    saturated_mass = get_positive_float('Enter the saturated mass of the final membrane in g : ')\n",
        "\n",
        "    # Validate user input against logical physical boundaries\n",
        "    if measurement_validation(dry_length, dry_mass, final_length, final_mass, suspended_mass, saturated_mass):\n",
        "      break\n",
        "    else:\n",
        "      print(\"Please re-enter correct physical measurements.\\n\")\n",
        "\n",
        "  final_surface_area = final_length * final_width\n",
        "  final_volume = final_length * final_thickness * final_width\n",
        "  final_bulk_density = final_mass / final_volume\n",
        "  linear_shrinkage = (dry_length - final_length) / dry_length\n",
        "  mass_loss = (dry_mass - final_mass) / dry_mass\n",
        "\n",
        "  # Apparent porosity and water absorption calculation safely checking for division by zero\n",
        "  volume_of_open_pores = saturated_mass - final_mass\n",
        "  volume_of_membrane = saturated_mass - suspended_mass\n",
        "\n",
        "  if volume_of_membrane > 0:\n",
        "    apparent_porosity = (volume_of_open_pores / volume_of_membrane) * 100.0\n",
        "  else:\n",
        "    apparent_porosity = 0.0\n",
        "    print(\"Warning: Division by zero avoided in Apparent Porosity calculation (saturated mass == suspended mass)\")\n",
        "\n",
        "  water_absorption = (volume_of_open_pores / final_mass) * 100.0\n",
        "  relative_density = (final_bulk_density / theoritical_density) * 100.0 if theoritical_density > 0 else 0.0\n",
        "  total_porosity = 100.0 - relative_density\n",
        "\n",
        "  print(f\"\\nResults:\")\n",
        "  print(f\"  Final Surface Area: {final_surface_area:.2f} mm^2\")\n",
        "  print(f\"  Final Volume: {final_volume:.2f} mm^3\")\n",
        "  print(f\"  Final Bulk Density: {final_bulk_density:.4f} g/cm^3\")\n",
        "  print(f\"  Linear Shrinkage: {linear_shrinkage:.4f} ({linear_shrinkage*100:.2f}%)\")\n",
        "  print(f\"  Mass Loss: {mass_loss:.4f} ({mass_loss*100:.2f}%)\")\n",
        "  print(f\"  Apparent Porosity: {apparent_porosity:.2f}%\")\n",
        "  print(f\"  Water Absorption: {water_absorption:.2f}%\")\n",
        "  print(f\"  Relative Density: {relative_density:.2f}%\")\n",
        "  print(f\"  Total Porosity: {total_porosity:.2f}%\")\n",
        "\n",
        "  return apparent_porosity, final_surface_area, final_thickness"
      ],
