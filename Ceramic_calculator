        "import math\n",
        "\n",
        "def membrane_performance_and_classification(apparent_porosity, membrane_area, membrane_thickness):\n",
        "  \"\"\"\n",
        "  Calculates water permeability, estimates average pore size via the Guerout-Elford-Ferry Equation,\n",
        "  and classifies the ceramic membrane.\n",
        "  \"\"\"\n",
        "  print(\"\\n--- Membrane Performance Analysis ---\")\n",
        "  water_viscosity = get_positive_float(\"Enter the water viscosity (cP): \")\n",
        "  pressure_difference = get_positive_float(\"Enter the pressure difference (bar): \")\n",
        "  flow_rate = get_positive_float(\"Enter the measured water flow rate (mL/hour): \")\n",
        "\n",
        "  # Convert Apparent Porosity percentage to a fraction\n",
        "  epsilon = apparent_porosity / 100.0\n",
        "\n",
        "  # Permeability calculated using Darcy's Law\n",
        "  permeability = (flow_rate * water_viscosity * membrane_thickness) / pressure_difference if pressure_difference > 0 else 0.0\n",
        "\n",
        "  # Average pore size calculation using the Guerout–Elford–Ferry Equation\n",
        "  # Apparent_porosity must be expressed as a fraction (epsilon) to prevent negative terms in square root\n",
        "  try:\n",
        "    inner_term = (2.9 - 1.75 * epsilon) * 8 * water_viscosity * membrane_thickness * flow_rate\n",
        "    if inner_term < 0:\n",
        "      raise ValueError(\"Square root input is negative\")\n",
        "    average_pore_size = math.sqrt(inner_term) / (epsilon * membrane_area * pressure_difference) if (epsilon * membrane_area * pressure_difference) > 0 else 0.0\n",
        "  except Exception as e:\n",
        "    print(f\"Error calculating average pore size: {e}\")\n",
        "    average_pore_size = 0.0\n",
        "\n",
        "  # Average pore size classification (assuming unit is in microns)\n",
        "  # (Macroporous > 50, 2 < Mesoporous <= 50, Microporous <= 2)\n",
        "  if average_pore_size > 50.0:\n",
        "    classification = \"Macroporous\"\n",
        "    application = \"Microfiltration (macroporous structures)\"\n",
        "  elif 2.0 < average_pore_size <= 50.0:\n",
        "    classification = \"Mesoporous\"\n",
        "    application = \"Microfiltration (micro & meso structures)\"\n",
        "  else:\n",
        "    classification = \"Microporous\"\n",
        "    application = \"Ultrafiltration (micro & nanostructure structures)\"\n",
        "\n",
        "  print(f\"\\nPerformance Metrics:\")\n",
        "  print(f\"  Water Permeability: {permeability:.4f}\")\n",
        "  print(f\"  Average Pore Size: {average_pore_size:.4f} microns\")\n",
        "  print(f\"  Membrane Classification: {classification}\")\n",
        "  print(f\"  Recommended Application: {application}\")\n",
        "\n",
        "def run_calculator():\n",
        "  print(\"=== Ceramic Membrane Material Science Calculator ===\\n\")\n",
        "  standardized_formulations()\n",
        "  dry_length, _, _, _, _, dry_mass, _, theoritical_density = initial_dimensions()\n",
        "  apparent_porosity, final_surface_area, final_thickness = final_measurement(dry_length, dry_mass, theoritical_density)\n",
        "  membrane_performance_and_classification(apparent_porosity, final_surface_area, final_thickness)\n",
        "\n",
        "run_calculator()"
      ],
